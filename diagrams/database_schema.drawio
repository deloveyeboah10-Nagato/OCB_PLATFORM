       VARCHAR(100) remittance_transaction_channel\n        VARCHAR(100) remittance_type\n        VARCHAR(100) remittance_status\n        DECIMAL(18,4) remittance_amount\n        CHAR(3) remittance_currency\n    }\n    ananse_transaction {\n        VARCHAR(100) transaction_id PK\n        VARCHAR(100) customer_id FK\n        BIGINT wallet_id FK\n        BIGINT ocb_customer_id FK\n        NVARCHAR(150) transaction_status\n        NVARCHAR(150) transaction_type\n        NVARCHAR(150) transaction_channel\n        NVARCHAR(150) transaction_currency\n        NVARCHAR(150) transaction_location_region\n        NVARCHAR(150) transaction_location_town\n        VARCHAR(100) device_id\n        DECIMAL(18,4) transaction_amount\n    }\n    sikacredit_repayment {\n        VARCHAR(100) repayment_id PK\n        VARCHAR(100) loan_id FK\n        BIGINT ocb_customer_id FK\n        DECIMAL(18,4) repayment_amount\n        NVARCHAR(150) repayment_location_region\n        NVARCHAR(150) repayment_location_town\n    }\n    ocb_customer ||--o{ ocb_customer_identity : \&quot;ocb_customer_id\&quot;\n    ocb_customer ||--o{ ananse_customer : \&quot;ocb_customer_id\&quot;\n    ocb_customer ||--o{ sikacredit_customer : \&quot;ocb_customer_id\&quot;\n    ocb_customer ||--o{ oman_remit_customer : \&quot;ocb_customer_id\&quot;\n    ananse_customer ||--o{ ananse_wallet : \&quot;customer_id\&quot;\n    ocb_customer ||--o{ ananse_wallet : \&quot;ocb_customer_id\&quot;\n    sikacredit_customer ||--o{ sikacredit_loan : \&quot;customer_id\&quot;\n    ocb_customer ||--o{ sikacredit_loan : \&quot;ocb_customer_id\&quot;\n    oman_remit_customer ||--o{ oman_remit_remittance : \&quot;customer_id\&quot;\n    ocb_customer ||--o{ oman_remit_remittance : \&quot;ocb_customer_id\&quot;\n    ananse_customer ||--o{ ananse_transaction : \&quot;customer_id\&quot;\n    ananse_wallet ||--o{ ananse_transaction : \&quot;wallet_id\&quot;\n    ocb_customer ||--o{ ananse_transaction : \&quot;ocb_customer_id\&quot;\n    sikacred