<mxfile host="app.diagrams.net" type="device"><diagram name="BRONZE Schema" id="bronze-schema"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="" mermaidData="{&quot;data&quot;: &quot;erDiagram\n    load_batch {\n        BIGINT load_id PK\n        VARCHAR(100) source_entity\n        NVARCHAR(255) source_file_name\n    }\n    ref_transaction_type {\n        BIGINT transaction_type_id PK\n        VARCHAR(20) transaction_type_code\n        VARCHAR(100) transaction_type_name\n    }\n    ref_transaction_status {\n        BIGINT transaction_status_id PK\n        VARCHAR(20) transaction_status_code\n        VARCHAR(100) transaction_status_name\n    }\n    ref_transaction_channel {\n        BIGINT transaction_channel_id PK\n        VARCHAR(20) transaction_channel_code\n        VARCHAR(100) transaction_channel_name\n    }\n    ref_currency {\n        BIGINT currency_id PK\n        CHAR(3) currency_code\n        VARCHAR(100) currency_name\n    }\n    ref_country {\n        BIGINT country_id PK\n        CHAR(3) country_code\n        NVARCHAR(150) country_name\n    }\n    ananse_customer {\n        VARCHAR(100) customer_id PK\n        NVARCHAR(150) first_name\n        NVARCHAR(150) last_name\n        DATE date_of_birth\n        NVARCHAR(150) nationality\n        NVARCHAR(150) occupation\n        VARCHAR(30) phone_number\n        NVARCHAR(150) email\n    }\n    sikacredit_customer {\n        VARCHAR(100) customer_id PK\n        NVARCHAR(150) first_name\n        NVARCHAR(150) last_name\n        DATE date_of_birth\n        NVARCHAR(150) nationality\n        NVARCHAR(150) occupation\n        VARCHAR(30) phone_number\n        NVARCHAR(150) email\n    }\n    oman_remit_customer {\n        VARCHAR(100) customer_id PK\n        NVARCHAR(150) first_name\n        NVARCHAR(150) last_name\n        DATE date_of_birth\n        NVARCHAR(150) nationality\n        NVARCHAR(150) occupation\n        VARCHAR(30) phone_number\n        NVARCHAR(150) email\n    }\n    ananse_wallet {\n        BIGINT wallet_id PK\n        VARCHAR(100) customer_id FK\n    }\n    sikacredit_loan {\n        VARCHAR(100) loan_id PK\n        VARCHAR(100) customer_id FK\n        NVARCHAR(150) disbursement_location\n        DATE maturity_date\n        DECIMAL(18,4) principal_amount\n        DECIMAL(5,4) interest_rate\n        CHAR(3) currency\n    }\n    oman_remit_remittance {\n        VARCHAR(100) remittance_id PK\n        VARCHAR(100) customer_id FK\n        BIGINT country_id FK\n        VARCHAR(50) remittance_status\n        NVARCHAR(150) transaction_location\n        DECIMAL(18,4) amount\n        CHAR(3) currency\n        VARCHAR(100) transaction_channel\n    }\n    ananse_transaction {\n        VARCHAR(100) transaction_id PK\n        VARCHAR(100) customer_id FK\n        BIGINT wallet_id FK\n        BIGINT transaction_status_id FK\n        BIGINT transaction_type_id FK\n        BIGINT transaction_channel_id FK\n        BIGINT currency_id FK\n        NVARCHAR(150) transaction_location\n        VARCHAR(100) device_id\n        DECIMAL(18,4) amount\n    }\n    sikacredit_repayment {\n        VARCHAR(100) repayment_id PK\n        VARCHAR(100) loan_id FK\n        DECIMAL(18,4) repayment_amount\n        NVARCHAR(150) repayment_location\n    }\n    ananse_customer ||--o{ ananse_wallet : \&quot;customer_id\&quot;\n    sikacredit_customer ||--o{ sikacredit_loan : \&quot;customer_id\&quot;\n    oman_remit_customer ||--o{ oman_remit_remittance : \&quot;customer_id\&quot;\n    ref_country ||--o{ oman_remit_remittance : \&quot;country_id\&quot;\n    ananse_customer ||--o{ ananse_transaction : \&quot;customer_id\&quot;\n    ananse_wallet ||--o{ ananse_transaction : \&quot;wallet_id\&quot;\n    ref_transaction_status ||--o{ ananse_transaction : \&quot;transaction_status_id\&quot;\n    ref_tran