        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    LOAD_BATCH {\n        BIGINT load_id PK\n        VARCHAR source_entity\n        NVARCHAR source_file_name\n        DATETIME2 load_timestamp\n    }\n\n    REF_TRANSACTION_TYPE {\n        BIGINT transaction_type_id PK\n        VARCHAR transaction_type_code\n        VARCHAR transaction_type_name\n    }\n\n    REF_TRANSACTION_STATUS {\n        BIGINT transaction_status_id PK\n        VARCHAR transaction_status_code\n        VARCHAR transaction_status_name\n    }\n\n    REF_TRANSACTION_CHANNEL {\n        BIGINT transaction_channel_id PK\n        VARCHAR transaction_channel_code\n        VARCHAR transaction_channel_name\n    }\n\n    REF_CURRENCY {\n        BIGINT currency_id PK\n        CHAR currency_code\n        VARCHAR currency_name\n    }\n\n    REF_COUNTRY {\n        BIGINT country_id PK\n        CHAR country_code\n        NVARCHAR country_name\n    }\n\n    OCB_CUSTOMER {\n        BIGINT ocb_customer_id PK\n        NVARCHAR first_name\n        NVARCHAR last_name\n        DATE date_of_birth\n        VARCHAR phone_number\n        NVARCHAR email\n    }\n\n    OCB_CUSTOMER_IDENTITY {\n        NVARCHAR source_entity PK\n        VARCHAR source_customer_id PK\n        VARCHAR cross_domain_id\n        BIGINT ocb_customer_id FK\n    }\n\n    ANANSE_CUSTOMER {\n        VARCHAR customer_id PK\n        BIGINT ocb_customer_id FK\n        NVARCHAR first_name\n        NVARCHAR last_name\n        DATE date_of_birth\n        NVARCHAR nationality\n        NVARCHAR occupation\n        VARCHAR phone_number\n        NVARCHAR email\n        DATETIME2 created_at\n    }\n\n    ANANSE_WALLET {\n        BIGINT wallet_id PK\n        VARCHAR customer_id FK\n        BIGINT ocb_customer_id FK\n    }\n\n    ANANSE_TRANSACTION {\n        VARCHAR transaction_id PK\n        VARCHAR customer_id FK\n        BIGINT wallet_id FK\n        BIGINT ocb_customer_id FK\n        NVARCHAR transaction_status\n        NVARCHAR transaction_type\n        NVARCHAR transaction_channel\n        NVARCHAR transaction_currency\n        DATETIME2 transaction_timestamp\n        NVARCHAR transaction_location_region\n        NVARCHAR transaction_location_town\n        VARCHAR device_id\n        DECIMAL transaction_amount\n    }\n\n    SIKACREDIT_CUSTOMER {\n        VARCHAR customer_id PK\n        BIGINT ocb_customer_id FK\n        NVARCHAR first_name\n        NVARCHAR last_name\n        DATE date_of_birth\n        NVARCHAR nationality\n        NVARCHAR occupation\n        VARCHAR phone_number\n        NVARCHAR email\n        DATETIME2 created_at\n    }\n\n    SIKACREDIT_LOAN {\n        VARCHAR loan_id PK\n        VARCHAR customer_id FK\n        BIGINT ocb_customer_id FK\n        DATETIME2 disbursement_timestamp\n        NVARCHAR disbursement_location_region\n        NVARCHAR disbursement_location_town\n        DATE maturity_date\n        DECIMAL principal_amount\n        DECIMAL interest_rate\n        CHAR loan_currency\n    }\n\n    SIKACREDIT_REPAYMENT {\n        VARCHAR repayment_id PK\n        VARCHAR loan_id FK\n        BIGINT ocb_customer_id FK\n        DECIMAL repayment_amount\n        DATETIME2 repayment_timestamp\n        NVARCHAR repayment_location_region\n        NVARCHAR repayment_location_town\n    }\n\n    OMAN_REMIT_CUSTOMER {\n        VARCHAR customer_id PK\n        BIGINT ocb_customer_id FK\n        NVARCHAR first_name\n        NVARCHAR last_name\n        DATE date_of_birth\n        NVARCHAR nationality\n        NVARCHAR occupation\n        VARCHAR phone_number\n        NVARCHAR email\n        DATETIME2 created_at\n    }\n\n    OMAN_REMIT_REMITTANCE {\n        VARCHAR remittance_id PK\n        VARCHAR customer_id FK\n        BIGINT ocb_customer_id FK\n        NVARCHAR remittance_origin_country\n        NVARCHAR remittance_location_region\n        NVARCHAR remittance_location_town\n        VARCHAR remittance_transaction_channel\n        VARCHAR remittance_type\n        VARCHAR remittance_status\n        DATETIME2 remittance_timestamp\n        DECIMAL remittance_amount\n        CHAR remittance_currency\n    }\n\n    OCB_CUSTOMER ||--o{ OCB_CUSTOMER_IDENTITY : maps\n    OCB_CUSTOMER ||--o{ ANANSE_CUSTOMER : resolves\n    OCB_CUSTOMER ||--o{ ANANSE_WALLET : identifies\n    OCB_CUSTOMER ||--o{ ANANSE_TRANSACTION : identifies\n\n    ANANSE_CUSTOMER ||--o{ ANANSE_WALLET : owns\n    ANANSE_CUSTOMER ||--o{ ANANSE_TRANSACTION : performs\n    ANANSE_WALLET ||--o{ ANANSE_TRANSACTION : records\n\n    OCB_CUSTOMER ||--o{ SIKACREDIT_CUSTOMER : resolves\n    OCB_CUSTOMER ||--o{ SIKACREDIT_LOAN : identifies\n    OCB_CUSTOMER ||--o{ SIKACREDIT_REPAYMENT : identifies\n\n    SIKACREDIT_CUSTOMER ||--o{ SIKACREDIT_LOAN : holds\n    SIKACREDIT_LOAN ||--o{ SIKACREDIT_REPAYMENT : receives\n\n    OCB_CUSTOMER ||--o{ OMAN_REMIT_CUSTOMER : resolves\n    OCB_CUSTOMER ||--o{ OMAN_REMIT_REMITTANCE : identifies\n\n    OMAN_REMIT_CUSTOMER ||--o{ OMAN_REMIT_REMITTANCE : initiates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="C2n9dJW9x8kAuZxELrJs-1">
