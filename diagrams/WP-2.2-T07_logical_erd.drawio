<mxfile host="Electron">
  <diagram name="Page-1" id="tIwOiwJOPqPQzKmRBnyd">
    <mxGraphModel dx="1245" dy="690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    %% ============================================================\n    %% OCB IDENTITY\n    %% ============================================================\n\n    OCB_CUSTOMER {\n        BIGINT ocb_customer_id PK\n    }\n\n    OCB_CUSTOMER_IDENTITY {\n        BIGINT ocb_customer_id FK\n        string source_entity PK\n        string source_customer_id PK\n        datetime created_at\n    }\n\n\n    %% ============================================================\n    %% ANANSE TELECOM\n    %% ============================================================\n\n    ANANSE_CUSTOMER {\n        string customer_id PK\n        string first_name\n        string last_name\n        date date_of_birth\n        string nationality\n        string occupation\n        string phone_number\n        string email\n        datetime created_at\n    }\n\n    ANANSE_TRANSACTION {\n        string transaction_id PK\n        string customer_id FK\n        BIGINT wallet_id FK\n        BIGINT transaction_status_id FK\n        BIGINT transaction_type_id FK\n        BIGINT transaction_channel_id FK\n        BIGINT currency_id FK\n        datetime transaction_timestamp\n        string transaction_location\n        string device_id\n        decimal amount\n    }\n\n    WALLET {\n        BIGINT wallet_id PK\n        string customer_id FK\n    }\n\n\n    %% ============================================================\n    %% SIKACREDIT\n    %% ============================================================\n\n    SIKACREDIT_CUSTOMER {\n        string customer_id PK\n        string first_name\n        string last_name\n        date date_of_birth\n        string nationality\n        string occupation\n        string phone_number\n        string email\n        datetime created_at\n    }\n\n    SIKACREDIT_LOAN {\n        string loan_id PK\n        string customer_id FK\n        datetime disbursement_timestamp\n        string disbursement_location\n        date maturity_date\n        decimal principal_amount\n        decimal interest_rate\n        string currency\n    }\n\n    SIKACREDIT_REPAYMENT {\n        string repayment_id PK\n        string loan_id FK\n        decimal repayment_amount\n        datetime repayment_timestamp\n        string repayment_location\n    }\n\n\n    %% ============================================================\n    %% OMAN REMIT\n    %% ============================================================\n\n    OMAN_REMIT_CUSTOMER {\n        string customer_id PK\n        string first_name\n        string last_name\n        date date_of_birth\n        string nationality\n        string occupation\n        string phone_number\n        string email\n        datetime created_at\n    }\n\n    OMAN_REMIT_REMITTANCE {\n        string remittance_id PK\n        string customer_id FK\n        BIGINT country_id FK\n        string remittance_status\n        datetime remittance_timestamp\n        string transaction_location\n        decimal amount\n        string currency\n        string transaction_channel\n    }\n\n\n    %% ============================================================\n    %% LEDGER / FINANCIAL CORE\n    %% ============================================================\n\n    FINANCIAL_EVENT {\n        BIGINT financial_event_id PK\n        string source_entity\n        string source_event_id\n        string event_type\n        datetime event_timestamp\n        string event_status\n    }\n\n    FINANCIAL_CONSEQUENCE {\n        BIGINT financial_consequence_id PK\n        BIGINT financial_event_id\n        string consequence_type\n        decimal amount\n        string currency\n        BIGINT wallet_id\n        string customer_id\n    }\n\n    LEDGER_ENTRY {\n        BIGINT ledger_entry_id PK\n        BIGINT financial_consequence_id\n        BIGINT financial_event_id\n        string transaction_id\n        BIGINT wallet_id\n        string account_reference\n        string entry_type\n        decimal amount\n        string currency\n        datetime entry_timestamp\n    }\n\n\n    %% ============================================================\n    %% REFERENCE DATA\n    %% ============================================================\n\n    TRANSACTION_TYPE {\n        BIGINT transaction_type_id PK\n        string transaction_type_code\n        string transaction_type_name\n    }\n\n    TRANSACTION_STATUS {\n        BIGINT transaction_status_id PK\n        string transaction_status_code\n        string transaction_status_name\n    }\n\n    TRANSACTION_CHANNEL {\n        BIGINT transaction_channel_id PK\n        string transaction_channel_code\n        string transaction_channel_name\n    }\n\n    CURRENCY {\n        BIGINT currency_id PK\n        string currency_code\n        string currency_name\n    }\n\n    COUNTRY {\n        BIGINT country_id PK\n        string country_code\n        string country_name\n    }\n\n\n    %% ============================================================\n    %% FOREIGN-KEY RELATIONSHIPS — PHYSICAL DEPLOYMENT\n    %% ============================================================\n\n    OCB_CUSTOMER ||--o{ OCB_CUSTOMER_IDENTITY : \&quot;resolves\&quot;\n\n    ANANSE_CUSTOMER ||--o{ WALLET : \&quot;owns\&quot;\n    ANANSE_CUSTOMER ||--o{ ANANSE_TRANSACTION : \&quot;performs\&quot;\n\n    WALLET ||--o{ ANANSE_TRANSACTION : \&quot;records\&quot;\n\n    TRANSACTION_TYPE ||--o{ ANANSE_TRANSACTION : \&quot;classifies\&quot;\n    TRANSACTION_STATUS ||--o{ ANANSE_TRANSACTION : \&quot;classifies\&quot;\n    TRANSACTION_CHANNEL ||--o{ ANANSE_TRANSACTION : \&quot;classifies\&quot;\n    CURRENCY ||--o{ ANANSE_TRANSACTION : \&quot;denominates\&quot;\n\n    SIKACREDIT_CUSTOMER ||--o{ SIKACREDIT_LOAN : \&quot;holds\&quot;\n    SIKACREDIT_LOAN ||--o{ SIKACREDIT_REPAYMENT : \&quot;receives\&quot;\n\n    OMAN_REMIT_CUSTOMER ||--o{ OMAN_REMIT_REMITTANCE : \&quot;initiates\&quot;\n    COUNTRY ||--o{ OMAN_REMIT_REMITTANCE : \&quot;originates_from\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="C2n9dJW9x8kAuZxELrJs-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
