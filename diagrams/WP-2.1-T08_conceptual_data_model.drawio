        </UserObject>
        <UserObject label="LEDGER REPRESENTATION PRINCIPLE&#xa;&#xa;Ledger Entry records accounting consequences&#xa;arising from authoritative financial activity.&#xa;It does not replace the originating financial object or event." mermaidId="n:NOTE3" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="LEDGER REPRESENTATION PRINCIPLE&#xa;&#xa;Ledger Entry records accounting consequences&#xa;arising from authoritative financial activity.&#xa;It does not replace the originating financial object or event." id="XsrHqBVfJDud1DoCkDES-17">
