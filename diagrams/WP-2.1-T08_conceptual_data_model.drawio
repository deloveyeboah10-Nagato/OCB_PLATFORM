        <UserObject label="CUSTOMER PRINCIPLE&#xa;&#xa;Customer is the cross-institutional actor.&#xa;Institutions remain operationally independent." mermaidId="n:NOTE1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="CUSTOMER PRINCIPLE&#xa;&#xa;Customer is the cross-institutional actor.&#xa;Institutions remain operationally independent." id="XsrHqBVfJDud1DoCkDES-15">
