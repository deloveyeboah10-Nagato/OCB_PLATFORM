        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% CROSS-INSTITUTIONAL ACTOR\n    Customer[\&quot;CUSTOMER\&quot;]\n\n    %% ANANSE TELECOM DOMAIN\n    subgraph ANANSE[\&quot;ANANSE TELECOM\&quot;]\n        Wallet[\&quot;WALLET\&quot;]\n        Transaction[\&quot;TRANSACTION\&quot;]\n    end\n\n    %% SIKACREDIT DOMAIN\n    subgraph SIKA[\&quot;SIKACREDIT\&quot;]\n        Loan[\&quot;LOAN\&quot;]\n    end\n\n    %% OMAN REMIT DOMAIN\n    subgraph OMAN[\&quot;OMAN REMIT\&quot;]\n        Remittance[\&quot;REMITTANCE\&quot;]\n    end\n\n    %% CROSS-DOMAIN ACCOUNTING\n    subgraph ACCOUNTING[\&quot;CROSS-DOMAIN ACCOUNTING\&quot;]\n        LedgerEntry[\&quot;LEDGER ENTRY\&quot;]\n    end\n\n    %% CUSTOMER RELATIONSHIPS\n    Customer --&gt;|\&quot;associated with\&quot;| Wallet\n    Customer --&gt;|\&quot;participates in\&quot;| Loan\n    Customer --&gt;|\&quot;participates in\&quot;| Remittance\n\n    %% ANANSE RELATIONSHIP\n    Wallet --&gt;|\&quot;participates in\&quot;| Transaction\n\n    %% CROSS-DOMAIN ACCOUNTING RELATIONSHIPS\n    Transaction --&gt;|\&quot;may give rise to accounting consequence\&quot;| LedgerEntry\n    Loan --&gt;|\&quot;may give rise to accounting consequence\&quot;| LedgerEntry\n    Remittance --&gt;|\&quot;may give rise to accounting consequence\&quot;| LedgerEntry\n\n    %% MODEL BOUNDARY NOTES\n    Note1[\&quot;Customer is the cross-institutional actor.&lt;br/&gt;Institutions remain operationally independent.\&quot;]\n    Note2[\&quot;Ledger Entry records accounting consequences&lt;br/&gt;arising from authoritative financial activity.\&quot;]\n    Note3[\&quot;No shared accounts, databases, ledgers,&lt;br/&gt;or operational infrastructure are assumed.\&quot;]\n\n    Note1 -.-&gt; Customer\n    Note2 -.-&gt; LedgerEntry&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DjbL29cjjJZ3ciFaaOKf-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="223" width="1679" as="geometry" />
          </mxCell>
        </UserObject>
