<mxfile host="Electron">
  <diagram name="Page-1" id="fgkWyab_I-0wM23kDwcm">
    <mxGraphModel dx="1761" dy="789" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% ==========================================\n    %% CROSS-INSTITUTIONAL ACTOR\n    %% ==========================================\n\n    CUSTOMER[\&quot;CUSTOMER\&quot;]\n\n\n    %% ==========================================\n    %% ANANSE TELECOM DOMAIN\n    %% ==========================================\n\n    subgraph ANANSE[\&quot;ANANSE TELECOM\&quot;]\n        WALLET[\&quot;WALLET\&quot;]\n        TRANSACTION[\&quot;TRANSACTION\&quot;]\n    end\n\n\n    %% ==========================================\n    %% SIKACREDIT DOMAIN\n    %% ==========================================\n\n    subgraph SIKA[\&quot;SIKACREDIT\&quot;]\n        LOAN[\&quot;LOAN\&quot;]\n    end\n\n\n    %% ==========================================\n    %% OMAN REMIT DOMAIN\n    %% ==========================================\n\n    subgraph OMAN[\&quot;OMAN REMIT\&quot;]\n        REMITTANCE[\&quot;REMITTANCE\&quot;]\n        BENEFICIARY[\&quot;BENEFICIARY FINANCIAL POSITION\&quot;]\n    end\n\n\n    %% ==========================================\n    %% OCB ANALYTICAL REPRESENTATION\n    %% ==========================================\n\n    subgraph OCB[\&quot;OCB ANALYTICAL REPRESENTATION\&quot;]\n        LEDGER_ENTRY[\&quot;LEDGER ENTRY\&quot;]\n    end\n\n\n    %% ==========================================\n    %% CUSTOMER RELATIONSHIPS\n    %% ==========================================\n\n    CUSTOMER --&gt;|\&quot;associated with\&quot;| WALLET\n    CUSTOMER --&gt;|\&quot;participates in\&quot;| LOAN\n    CUSTOMER --&gt;|\&quot;participates in\&quot;| REMITTANCE\n\n\n    %% ==========================================\n    %% ANANSE RELATIONSHIPS\n    %% ==========================================\n\n    WALLET --&gt;|\&quot;participates in\&quot;| TRANSACTION\n\n\n    %% ==========================================\n    %% OMAN REMIT RELATIONSHIPS\n    %% ==========================================\n\n    REMITTANCE --&gt;|\&quot;relates to\&quot;| BENEFICIARY\n\n\n    %% ==========================================\n    %% ACCOUNTING CONSEQUENCES\n    %% ==========================================\n\n    TRANSACTION --&gt;|\&quot;may give rise to accounting consequence\&quot;| LEDGER_ENTRY\n    LOAN --&gt;|\&quot;may give rise to accounting consequence\&quot;| LEDGER_ENTRY\n    REMITTANCE --&gt;|\&quot;may give rise to accounting consequence\&quot;| LEDGER_ENTRY\n\n\n    %% ==========================================\n    %% MODEL-LEVEL PRINCIPLES\n    %% ==========================================\n\n    NOTE1[\&quot;CUSTOMER PRINCIPLE&lt;br/&gt;&lt;br/&gt;Customer is the cross-institutional actor.&lt;br/&gt;Institutions remain operationally independent.\&quot;]\n\n    NOTE2[\&quot;INSTITUTIONAL OWNERSHIP PRINCIPLE&lt;br/&gt;&lt;br/&gt;Institutional financial objects remain institution-owned.&lt;br/&gt;OCB observes and resolves them.&lt;br/&gt;Their financial consequences can be represented&lt;br/&gt;in OCB&#39;s analytical ledger model.\&quot;]\n\n    NOTE3[\&quot;LEDGER REPRESENTATION PRINCIPLE&lt;br/&gt;&lt;br/&gt;Ledger Entry records accounting consequences&lt;br/&gt;arising from authoritative financial activity.&lt;br/&gt;It does not replace the originating financial object or event.\&quot;]\n\n    NOTE4[\&quot;INSTITUTIONAL BOUNDARY PRINCIPLE&lt;br/&gt;&lt;br/&gt;No shared accounts, databases, ledgers,&lt;br/&gt;or operational infrastructure are assumed.\&quot;]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XsrHqBVfJDud1DoCkDES-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
